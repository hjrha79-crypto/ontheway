<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0F"
    android:fitsSystemWindows="true">

    <!-- ═══ HEADER ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/logoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OnTheWay"
            android:textSize="18sp"
            android:textColor="#00FF88"
            android:fontFamily="sans-serif-medium"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/earningText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0원"
            android:textSize="18sp"
            android:textColor="#00FF88"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/svcBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="접근성"
            android:textSize="11sp"
            android:textColor="#A0A0C0"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/favBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="즐겨찾기"
            android:textSize="11sp"
            android:textColor="#A0A0C0"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/settingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="설정"
            android:textSize="11sp"
            android:textColor="#A0A0C0"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/statsBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="통계"
            android:textSize="11sp"
            android:textColor="#A0A0C0"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </LinearLayout>

    <!-- 수익 서브 + 프로그레스 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/earningMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0콜 · 0원/h · 목표 100,000원"
            android:textSize="11sp"
            android:textColor="#A0A0C0"
            android:paddingBottom="5dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/progress_track_bg">
            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/progress_fill_bg" />
        </FrameLayout>
    </LinearLayout>

    <!-- ═══ Sprint 6: 운행 모드 카드 ═══ -->
    <LinearLayout
        android:id="@+id/drivingModeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#1A1A2E"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/drivingModeStatusTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="운행 모드: OFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/drivingModeDurationTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘 운행: 0분"
                android:textSize="12sp"
                android:textColor="#A0A0C0"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Switch
            android:id="@+id/drivingModeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- ═══ 체감 시급 카드 (전체 너비, 메인 표시) ═══ -->
    <LinearLayout
        android:id="@+id/hourlyRateCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:id="@+id/recentHourlyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#1A1A2E">

            <LinearLayout
                android:id="@+id/recentHourlyCardInner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/recentHourlyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="체감 시급 (최근 1시간)"
                    android:textColor="#A0A0C0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/recentHourlyRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="—원/h"
                    android:textColor="#00FF88"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- 운행 OFF 안내 (기본 숨김) -->
                <TextView
                    android:id="@+id/hourlyRateOffText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="운행 시작 후 표시"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- ═══ 누적 시급 (메인에서 숨김, 코드 보존) ═══ -->
    <TextView
        android:id="@+id/cumulativeHourlyRate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="—원/h" />

    <!-- ═══ 시뮬레이션 시급 (메인에서 숨김, 코드 보존) ═══ -->
    <LinearLayout
        android:id="@+id/simulationHourlyCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/simRecentHourlyRate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="—원/h" />
        <TextView
            android:id="@+id/simCumulativeHourlyRate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="—원/h" />
    </LinearLayout>

    <!-- ═══ 탭 바 ═══ -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0A0A0F"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tabStatus"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="상태"
            android:textSize="14sp"
            android:textColor="#00FF88"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <TextView
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="채팅"
            android:textSize="14sp"
            android:textColor="#A0A0C0"
            android:gravity="center" />
    </LinearLayout>

    <!-- 탭 인디케이터 라인 -->
    <FrameLayout
        android:id="@+id/tabIndicatorBar"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#1A1A2E">
        <View
            android:id="@+id/tabIndicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#00FF88" />
    </FrameLayout>

    <!-- ═══ 상태 대시보드 (기본 표시) ═══ -->
    <ScrollView
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:background="#0A0A0F"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- 필터 상태 카드 (확대) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A1A2E"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginBottom="10dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/filterStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="필터 대기 중"
                    android:textSize="16sp"
                    android:textColor="#00FF88"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/filterCountText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#A0A0C0"
                    android:paddingTop="4dp" />
            </LinearLayout>

            <!-- 마지막 콜 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A1A2E"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="10dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="마지막 콜"
                    android:textSize="11sp"
                    android:textColor="#A0A0C0"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/lastCallText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="대기 중..."
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- 최근 콜 리스트 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A1A2E"
                android:paddingTop="14dp"
                android:paddingBottom="8dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="최근 콜"
                    android:textSize="11sp"
                    android:textColor="#A0A0C0"
                    android:paddingStart="20dp"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:id="@+id/recentCallList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 앱 확인 횟수 -->
            <TextView
                android:id="@+id/appCheckText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#A0A0C0"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ═══ 채팅 패널 (기본 숨김) ═══ -->
    <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 즐겨찾기 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:id="@+id/placesRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A2E" />

        <!-- CHAT -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:background="#0A0A0F">
            <LinearLayout
                android:id="@+id/chatLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp" />
        </ScrollView>
    </LinearLayout>

    <!-- ═══ CALL CARD ═══ -->
    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/call_card_bg_v5"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:elevation="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/resultRoute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="#A0A0C0" />
            <TextView
                android:id="@+id/detailBtn"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="상세"
                android:textSize="11sp"
                android:textColor="#A0A0C0"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/detail_btn_bg"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="44sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.03" />

        <TextView
            android:id="@+id/resultTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#00FF88"
            android:paddingTop="2dp"
            android:paddingBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/acceptBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="3"
                android:layout_marginEnd="8dp"
                android:text="수락하기"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@drawable/accept_btn_bg"
                android:visibility="invisible" />
            <TextView
                android:id="@+id/skipBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="넘기기"
                android:textSize="14sp"
                android:textColor="#A0A0C0"
                android:gravity="center"
                android:background="@drawable/skip_btn_bg_new" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ INPUT ═══ -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0A0A0F"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/micBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="🎤"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/mic_bg" />

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:hint="메시지 입력..."
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999"
            android:background="@drawable/input_field_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:imeOptions="actionSend" />

        <TextView
            android:id="@+id/sendBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="↑"
            android:textSize="20sp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:background="@drawable/send_btn_bg_v3" />
    </LinearLayout>

</LinearLayout>
